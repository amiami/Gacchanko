<div class="max-w-2xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-4">シーンを作る</h1>

  <%= form_with model: @kit do |f| %>
    <div class="mb-4">
      <%= f.label :name, "シーン名", class: "block text-sm text-gray-500" %>
      <%= f.text_field :name, required: true,
            class: "border border-gray-300 rounded px-2 py-1 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :category, "カテゴリ", class: "block text-sm text-gray-500" %>
      <%= f.select :category, @categories.map { |k, v| [v, k] },
            { include_blank: "選択してください" },
            class: "border border-gray-300 rounded px-2 py-1" %>
    </div>

    <div class="mb-4">
      <%= label_tag "kit[item_names]", "持ち物（1行に1つ）",
            class: "block text-sm text-gray-500" %>
      <%= text_area_tag "kit[item_names]", nil, rows: 10,
            placeholder: "モバイルバッテリー\n充電ケーブル\n帽子",
            class: "border border-gray-300 rounded px-2 py-1 w-full font-mono text-sm" %>
    </div>

    <%= f.submit "作成する",
          class: "bg-green-700 text-white rounded px-4 py-2 cursor-pointer" %>
  <% end %>
</div>