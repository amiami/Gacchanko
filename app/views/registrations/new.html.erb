<div class="max-w-md mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-6">新規登録</h1>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= form_with model: @user, url: registration_path do |f| %>
      <% if @user.errors.any? %>
        <ul class="mb-4 text-sm text-red-600">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>

      <div class="mb-4">
        <%= f.label :email_address, "メールアドレス", class: "block text-sm text-gray-500" %>
        <%= f.email_field :email_address, required: true,
              class: "border border-gray-300 rounded px-2 py-1 w-full" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "パスワード", class: "block text-sm text-gray-500" %>
        <%= f.password_field :password, required: true, placeholder: "8文字以上",
              class: "border border-gray-300 rounded px-2 py-1 w-full" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-sm text-gray-500" %>
        <%= f.password_field :password_confirmation, required: true,
              class: "border border-gray-300 rounded px-2 py-1 w-full" %>
      </div>

      <%= f.submit "登録する",
            class: "bg-teal-600 text-white rounded px-4 py-2 cursor-pointer w-full" %>
    <% end %>

    <p class="text-sm text-gray-500 mt-4 text-center">
      <%= link_to "ログインはこちら", new_session_path, class: "text-teal-600 underline" %>
    </p>
  </div>
</div>