<div class="max-w-md mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-6">ログイン</h1>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= form_with url: session_path do |f| %>
      <div class="mb-4">
        <%= f.label :email_address, "メールアドレス", class: "block text-sm text-gray-500" %>
        <%= f.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username",
              class: "border border-gray-300 rounded px-2 py-1 w-full" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, "パスワード", class: "block text-sm text-gray-500" %>
        <%= f.password_field :password, required: true,
              autocomplete: "current-password",
              class: "border border-gray-300 rounded px-2 py-1 w-full" %>
      </div>

      <%= f.submit "ログイン",
            class: "bg-green-700 text-white rounded px-4 py-2 cursor-pointer w-full" %>
    <% end %>

    <%= button_to "ゲストとして試す", guest_login_path,
          class: "w-full border border-green-700 text-green-700 rounded px-4 py-2 mt-3 cursor-pointer" %>

    <p class="text-sm text-gray-500 mt-4 text-center">
      <%= link_to "新規登録はこちら", new_registration_path, class: "text-green-700 underline" %>
    </p>
  </div>
</div>