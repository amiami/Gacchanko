<style>
  input[type="checkbox"] {
    accent-color: #15803d;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }
</style>
<div class="max-w-2xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold"><%= @packing_list.name %></h1>
  <p class="mb-4 flex items-center gap-2">
    <span class="text-sm text-gray-500">
      <% if @packing_list.event_date %>
        <%= @packing_list.event_date&.strftime("%Y年%m月%d日") %>
      <% end %>
    </span>
    <% if @packing_list.upcoming? && !@packing_list.completed? %>
      <span class="text-xs bg-orange-100 text-orange-700 px-1.5 py-0.5 rounded">
        まもなく
      </span>
    <% end %>
    <span class="inline-block justify-self-end">
      <span id="progress" class="text-sm text-green-700"><%= @packing_list.checked_count %></span>
      / <span class="text-sm text-gray-500"><%= @packing_list.total_count %></span>
    </span>
  </p>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <ul class="space-y-2">
      <% @packing_list.list_items.each do |item| %>
        <li class="flex items-center gap-2">
          <%= check_box_tag "checked_#{item.id}", "1", item.is_checked,
                data: { item_id: item.id }, class: "item-check" %>
          <span class="<%= 'line-through text-gray-400' if item.is_checked %>">
            <%= item.item_name %>
          </span>
          <% item.source_labels.to_s.split(",").each do |label| %>
            <span class="px-1.5 py-0.5 text-xs rounded text-gray-400">
              <%= label %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<script>
  const checkboxes = document.querySelectorAll('.item-check');
  const progress = document.getElementById('progress');

  function updateProgress() {
    const n = [...checkboxes].filter(c => c.checked).length;
    progress.textContent = n;
  }
  
  checkboxes.forEach(cb => {
    cb.addEventListener('change', async () => {
      const id = cb.dataset.itemId;
      const label = cb.parentElement.querySelector('span');
      const checked = cb.checked;

      label.classList.toggle('line-through', checked);
      label.classList.toggle('text-gray-400', checked);

      updateProgress();

      const res = await fetch(`/list_items/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ is_checked: checked })
      });

      if (!res.ok) {
        alert('保存に失敗しました');
        cb.checked = !checked;
        label.classList.toggle('line-through', !checked);
        label.classList.toggle('text-gray-400', !checked);
        updateProgress();    // ← 失敗時も戻す
      }
    });
  });
</script>